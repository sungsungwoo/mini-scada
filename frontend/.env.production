# Production 빌드용 (GitHub Actions / docker build 가 그대로 사용).
# 값은 브라우저 번들에 포함되므로 “비밀키”가 아님 — API 키는 여기 넣지 말 것.
# 로컬에서만 다른 주소를 쓰려면 .env.production.local 을 추가 (git 무시).

# 백엔드를 다른 도메인에 둘 때만. 비우면 같은 출처로 /api 호출.
# VITE_API_ORIGIN=https://api.example.com

# MQTT WebSocket (Nginx 등으로 /mqtt 프록시 연결 시)
VITE_MQTT_WS_URL=wss://scada.swsung72.site/mqtt
