# Copy to .env and adjust. Used by docker compose and local Spring Boot (when exported).

DB_USER=scada
DB_PASSWORD=scada_secret
DB_NAME=mini_scada

# JWT and MQTT credentials — wired when auth/MQTT security is implemented
# HS256 requires at least 32 bytes (UTF-8 characters); use a long random string in production.
JWT_SECRET_KEY=mini-scada-dev-jwt-secret-min-32-chars-for-hs256-required
MQTT_USERNAME=
MQTT_PASSWORD=

SPRING_PROFILES_ACTIVE=local

# Comma-separated frontend origins (no trailing slash). Overrides defaults in application.yml.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://scada.swsung72.site
