server {
    server_name scada.swsung72.site;

    # API 요청: /api 접두사 제거 후 backend로 전달
    # /api/users -> http://127.0.0.1:18094/users
    location /api/ {
        proxy_pass http://127.0.0.1:18094;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # MQTT WebSocket 요청
    # 프론트에서 wss://scada.swsung72.site/mqtt/ 형태로 접속할 경우 사용
    location /mqtt {
        proxy_pass http://127.0.0.1:18095;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }


    # 나머지 요청은 frontend로 전달
    location / {
        proxy_pass http://127.0.0.1:18093;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    listen 80;
}

